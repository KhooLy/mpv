+static int mediacodec_dolby_vision_profile(const AVPacketSideData *sd)
+{
+    if (!sd || sd->size < sizeof(AVDOVIDecoderConfigurationRecord))
+        return -1;
+
+    const AVDOVIDecoderConfigurationRecord *cfg =
+        (const AVDOVIDecoderConfigurationRecord *)sd->data;
+    switch (cfg->dv_profile) {
+    case 4:  // DolbyVisionProfileDvheDtr
+        return 16;
+    case 5:  // DolbyVisionProfileDvheStn
+        return 32;
+    case 7:  // DolbyVisionProfileDvheDtb
+        return 128;
+    case 8:  // DolbyVisionProfileDvheSt
+        return 256;
+    case 9:  // DolbyVisionProfileDvavSe
+        return 512;
+    case 10: // DolbyVisionProfileDvav110
+        return 1024;
+    default:
+        return -1;
+    }
+}
+
+static const char *mediacodec_dolby_vision_alternative_mime(
+    AVCodecContext *avctx, const AVPacketSideData *sd, const char *base_codec_mime)
+{
+    const AVDOVIDecoderConfigurationRecord *cfg =
+        (const AVDOVIDecoderConfigurationRecord *)sd->data;
+    const char *mime = NULL;
+    switch (cfg->dv_profile) {
+    case 4:
+    case 8:
+        mime = "video/hevc";
+        break;
+    case 9:
+        mime = "video/avc";
+        break;
+    case 10:
+        if (avctx->color_trc == AVCOL_TRC_SMPTE2084 &&
+            avctx->color_range == AVCOL_RANGE_JPEG)
+            return NULL;
+        mime = "video/av01";
+        break;
+    default:
+        return NULL;
+    }
+    return base_codec_mime && !strcmp(mime, base_codec_mime) ? mime : NULL;
+}
