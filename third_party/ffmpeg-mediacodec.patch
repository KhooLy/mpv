+static void mediacodec_set_hdr_static_info(AVCodecContext *avctx,
+                                           FFAMediaFormat *format)
+{
+    const AVPacketSideData *sd = ff_get_coded_side_data(
+        avctx, AV_PKT_DATA_MASTERING_DISPLAY_METADATA);
+    if (!sd || sd->size < sizeof(AVMasteringDisplayMetadata))
+        return;
+    const AVMasteringDisplayMetadata *mdm =
+        (const AVMasteringDisplayMetadata *)sd->data;
+    if (!mdm->has_primaries || !mdm->has_luminance)
+        return;
+
+    unsigned max_cll = 0, max_fall = 0;
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_CONTENT_LIGHT_LEVEL);
+    if (sd && sd->size >= sizeof(AVContentLightMetadata)) {
+        const AVContentLightMetadata *clm = (const AVContentLightMetadata *)sd->data;
+        max_cll = clm->MaxCLL;
+        max_fall = clm->MaxFALL;
+    }
+
+    uint16_t values[12] = {
+        av_rescale_q(1, mdm->display_primaries[0][0], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->display_primaries[0][1], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->display_primaries[1][0], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->display_primaries[1][1], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->display_primaries[2][0], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->display_primaries[2][1], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->white_point[0], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->white_point[1], (AVRational){1, 50000}),
+        av_rescale_q(1, mdm->max_luminance, (AVRational){1, 1}),
+        av_rescale_q(1, mdm->min_luminance, (AVRational){1, 10000}),
+        FFMIN(max_cll, UINT16_MAX),
+        FFMIN(max_fall, UINT16_MAX),
+    };
+    uint8_t info[25] = {0};
+    for (int i = 0; i < 12; i++)
+        AV_WL16(info + 1 + 2 * i, values[i]);
+    ff_AMediaFormat_setBuffer(format, "hdr-static-info", info, sizeof(info));
+}
