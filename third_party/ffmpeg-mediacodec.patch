 } DoviRpuContext;
 
+static const int p81_ycc_to_rgb[9] = {
+    9574, 0, 13802, 9574, -1540, -5348, 9574, 17610, 0,
+};
+static const int p81_rgb_to_lms[9] = {
+    7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962,
+};
+
+static int is_mel(const AVDOVIRpuDataHeader *hdr, const AVDOVIDataMapping *map)
+{
+    if (map->nlq_method_idc == AV_DOVI_NLQ_NONE)
+        return 1;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *nlq = &map->nlq[c];
+        if (nlq->nlq_offset || nlq->vdr_in_max != 1ULL << hdr->coef_log2_denom ||
+            nlq->linear_deadzone_slope || nlq->linear_deadzone_threshold)
+            return 0;
+    }
+    return 1;
+}
+
+static void convert_to_p81(AVDOVIMetadata *md)
+{
+    AVDOVIRpuDataHeader *hdr = av_dovi_get_header(md);
+    AVDOVIDataMapping *map = av_dovi_get_mapping(md);
+    AVDOVIColorMetadata *color = av_dovi_get_color(md);
+
+    if (!is_mel(hdr, map)) {
+        for (int c = 0; c < 3; c++) {
+            AVDOVIReshapingCurve *curve = &map->curves[c];
+            memset(curve, 0, sizeof(*curve));
+            curve->num_pivots = 2;
+            curve->pivots[1] = (1 << hdr->bl_bit_depth) - 1;
+            curve->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+            curve->poly_order[0] = 1;
+            curve->poly_coef[0][1] = 1LL << hdr->coef_log2_denom;
+        }
+    }
+    hdr->disable_residual_flag = 1;
+    hdr->el_spatial_resampling_filter_flag = 0;
+    map->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    map->num_x_partitions = map->num_y_partitions = 1;
+    memset(map->nlq, 0, sizeof(map->nlq));
+
+    for (int i = 0; i < 9; i++) {
+        color->ycc_to_rgb_matrix[i] = av_make_q(p81_ycc_to_rgb[i], 1 << 13);
+        color->rgb_to_lms_matrix[i] = av_make_q(p81_rgb_to_lms[i], 1 << 14);
+    }
+    color->ycc_to_rgb_offset[0] = av_make_q(1 << 24, 1 << 28);
+    color->ycc_to_rgb_offset[1] = av_make_q(1 << 27, 1 << 28);
+    color->ycc_to_rgb_offset[2] = av_make_q(1 << 27, 1 << 28);
+    color->signal_color_space = 0;
+}
