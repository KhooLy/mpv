+static int mediacodec_jni_setParameterBuffer(FFAMediaCodec *ctx, const char *name,
+                                             const uint8_t *data, size_t size)
+{
+    int ret = AVERROR_EXTERNAL;
+    JNIEnv *env = NULL;
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+    jobject bundle = NULL;
+    jstring key = NULL;
+    jbyteArray array = NULL;
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
+
+    if (!codec->jfields.set_parameters_id || !codec->jfields.bundle_init_id ||
+        !codec->jfields.bundle_put_byte_array_id)
+        return AVERROR(ENOSYS);
+
+    bundle = (*env)->NewObject(env, codec->jfields.bundle_class, codec->jfields.bundle_init_id);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        goto fail;
+    key = ff_jni_utf_chars_to_jstring(env, name, codec);
+    if (!key)
+        goto fail;
+    array = (*env)->NewByteArray(env, size);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        goto fail;
+    (*env)->SetByteArrayRegion(env, array, 0, size, (const jbyte *)data);
+    (*env)->CallVoidMethod(env, bundle, codec->jfields.bundle_put_byte_array_id, key, array);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        goto fail;
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_parameters_id, bundle);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        goto fail;
+    ret = 0;
+
+fail:
+    (*env)->DeleteLocalRef(env, bundle);
+    (*env)->DeleteLocalRef(env, key);
+    (*env)->DeleteLocalRef(env, array);
+    return ret;
+}
