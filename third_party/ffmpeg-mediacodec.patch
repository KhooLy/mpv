+static void send_hdr10plus(AVCodecContext *avctx, FFAMediaCodec *codec, const AVPacket *pkt)
+{
+    static const uint8_t header[] = { 0xB5, 0x00, 0x3C, 0x00, 0x01, 0x04 };
+    const AVDynamicHDRPlus *hdr;
+    uint8_t *payload = NULL, *t35;
+    size_t payload_size = 0;
+
+    hdr = (const AVDynamicHDRPlus *)av_packet_get_side_data(pkt, AV_PKT_DATA_DYNAMIC_HDR10_PLUS, NULL);
+    if (!hdr || av_dynamic_hdr_plus_to_t35(hdr, &payload, &payload_size) < 0)
+        return;
+    t35 = av_malloc(sizeof(header) + payload_size);
+    if (t35) {
+        memcpy(t35, header, sizeof(header));
+        memcpy(t35 + sizeof(header), payload, payload_size);
+        if (ff_AMediaCodec_setParameterBuffer(codec, "hdr10-plus-info", t35,
+                                              sizeof(header) + payload_size) < 0)
+            av_log(avctx, AV_LOG_DEBUG, "Failed to pass HDR10+ metadata\n");
+        av_free(t35);
+    }
+    av_free(payload);
+}
