+static int mediacodec_dolby_vision_profile(const AVPacketSideData *sd)
+{
+    if (!sd || sd->size < sizeof(AVDOVIDecoderConfigurationRecord))
+        return -1;
+
+    const AVDOVIDecoderConfigurationRecord *cfg =
+        (const AVDOVIDecoderConfigurationRecord *)sd->data;
+    switch (cfg->dv_profile) {
+    case 4:  // DolbyVisionProfileDvheDtr
+        return 16;
+    case 5:  // DolbyVisionProfileDvheStn
+        return 32;
+    case 7:  // DolbyVisionProfileDvheDtb
+        return 128;
+    case 8:  // DolbyVisionProfileDvheSt
+        return 256;
+    case 9:  // DolbyVisionProfileDvavSe
+        return 512;
+    case 10: // DolbyVisionProfileDvav110
+        return 1024;
+    default:
+        return -1;
+    }
+}
+
+static void mediacodec_set_color_info(AVCodecContext *avctx,
+                                      FFAMediaFormat *format)
+{
+    int value;
+
+    value = ff_AMediaFormatColorRange_from_AVColorRange(avctx->color_range);
+    if (value != COLOR_RANGE_UNSPECIFIED)
+        ff_AMediaFormat_setInt32(format, "color-range", value);
+
+    value = ff_AMediaFormatColorStandard_from_AVColorSpace(avctx->colorspace);
+    if (value == COLOR_STANDARD_UNSPECIFIED &&
+        avctx->color_primaries == AVCOL_PRI_BT2020)
+        value = COLOR_STANDARD_BT2020;
+    if (value != COLOR_STANDARD_UNSPECIFIED)
+        ff_AMediaFormat_setInt32(format, "color-standard", value);
+
+    value = ff_AMediaFormatColorTransfer_from_AVColorTransfer(avctx->color_trc);
+    if (value != COLOR_TRANSFER_UNSPECIFIED)
+        ff_AMediaFormat_setInt32(format, "color-transfer", value);
+}
+
