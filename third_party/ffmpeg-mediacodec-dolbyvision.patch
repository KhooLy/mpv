+            s->ctx->delay_flush = s->delay_flush;
+            s->ctx->use_ndk_codec = s->use_ndk_codec;
+            int base_profile = ff_AMediaCodecProfile_getProfileFromAVCodecContext(avctx);
+            if (base_profile >= 0)
+                ff_AMediaFormat_setInt32(format, "profile", base_profile);
+            ret = ff_mediacodec_dec_init(avctx, s->ctx, base_codec_mime, format);
+            if (ret < 0)
+                s->ctx = NULL;
+            else
+                codec_mime = base_codec_mime;
+        }
+        if (ret < 0)
+            goto done;
     }
 
